{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nocobase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nocobase/mcp-server"
      ],
      "environment": {
        "NOCOBASE_URL": "{env:NOCOBASE_URL}",
        "NOCOBASE_EMAIL": "{env:NOCOBASE_EMAIL}",
        "NOCOBASE_PASSWORD": "{env:NOCOBASE_PASSWORD}"
      },
      "enabled": true
    }
  }
}