{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dokploy": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@dokploy/mcp"
      ],
      "environment": {
        "DOKPLOY_URL": "{env:DOKPLOY_URL}",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
      },
      "enabled": true
    }
  }
}