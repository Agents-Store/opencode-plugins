{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "directus": {
      "type": "remote",
      "url": "{env:NEXT_PUBLIC_DIRECTUS_URL}/mcp",
      "headers": {
        "Authorization": "Bearer {env:DIRECTUS_ADMIN_TOKEN}"
      },
      "enabled": true
    },
    "trigger-dev": {
      "type": "local",
      "command": [
        "npx",
        "trigger.dev@${TRIGGER_CLI_VERSION:-latest}",
        "mcp",
        "--dev-only",
        "--project-ref",
        "${TRIGGER_PROJECT_REF}"
      ],
      "environment": {
        "TRIGGER_ACCESS_TOKEN": "{env:TRIGGER_ACCESS_TOKEN}",
        "TRIGGER_API_URL": "{env:TRIGGER_API_URL}"
      },
      "enabled": true
    }
  }
}